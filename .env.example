# TopstepX / ProjectX gateway credentials
# Generate the API key in TopstepX: Settings -> API -> API Key
PROJECTX_USERNAME=
PROJECTX_API_KEY=

# Gateway hosts (TopstepX defaults)
PROJECTX_API_BASE=https://api.topstepx.com
PROJECTX_MARKET_HUB=https://rtc.topstepx.com/hubs/market

# false = Trading Combine / sim data entitlement
# true  = live funded account data entitlement
PROJECTX_LIVE_DATA=false

# Optional: pin a specific account id from /api/Account/search
# PROJECTX_ACCOUNT_ID=
